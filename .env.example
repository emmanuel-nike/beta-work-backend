TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=betawork
DB_PASSWORD=betawork
DB_DATABASE=betawork

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail / SMTP (optional — the app boots without these; OTP codes are also
# returned in the API response outside production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@betawork.app
MAIL_FROM_NAME=BetaWork
# Google Maps Platform key (Places API (New) + Geocoding API) for address search.
GOOGLE_MAPS_API_KEY=

# Firebase Cloud Messaging (push notifications) — optional; push is a no-op
# until set. From the service-account JSON (Firebase Console → Project settings
# → Service accounts → Generate new private key). Keep the private key on one
# line with newlines escaped as \n, wrapped in double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
